// Prisma schema for HR Tech Application
// Pure PostgreSQL - compatible with any provider (Neon, Railway, RDS, etc.)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  HR
  CANDIDATE
}

// Job status enum
enum JobStatus {
  DRAFT
  LIVE
  CLOSED
}

// User model - stores Firebase user metadata
model User {
  id           String   @id @default(uuid())
  firebase_uid String   @unique
  email        String   @unique
  name         String?
  role         UserRole @default(CANDIDATE)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Google OAuth tokens
  google_access_token  String?
  google_refresh_token String?
  google_token_expiry  DateTime?

  // Cache for dashboard data (emails and calendar events)
  cached_dashboard_data Json?
  last_dashboard_sync   DateTime?

  // Relations
  job_openings JobOpening[]
  meetings     Meeting[]

  @@map("users")
}

// Job Opening model
model JobOpening {
  id               String    @id @default(uuid())
  title            String
  company_name     String
  location         String
  job_type         String // Full-time, Part-time, Contract, Internship
  experience_level String // Entry, Mid, Senior, Lead
  description      String    @db.Text
  responsibilities String[] // Array of responsibilities
  required_skills  String[] // Array of required skills
  preferred_skills String[] // Array of preferred skills
  stipend          String? // Salary/Stipend range
  status           JobStatus @default(LIVE)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // ATS JD Parsing Results
  jd_hard_requirements   String[] @default([]) // Hard requirements from ATS parsing
  jd_preferred_skills    String[] @default([]) // Preferred skills from ATS parsing
  jd_skill_normalization Json? // Skill normalization mapping

  // Relations
  created_by   String
  creator      User          @relation(fields: [created_by], references: [id])
  applications Application[]

  @@map("job_openings")
}

// Application model
model Application {
  id              String   @id @default(uuid())
  candidate_name  String
  candidate_email String
  resume_url      String
  github_url      String?
  portfolio_url   String?
  created_at      DateTime @default(now())
  linkedin_url    String?
  social_data     Json?

  // ATS Scoring Results
  ats_score          Int? // ATS score (0-100)
  ats_decision       String? // Decision: "Accept", "Reject", etc.
  ats_missing_skills String[] @default([]) // Missing skills identified
  ats_reasons        String[] @default([]) // Reasons for the score

  // Relations
  job_id String
  job    JobOpening @relation(fields: [job_id], references: [id], onDelete: Cascade)

  // Interview relation
  interviews Interview[]

  @@map("applications")
}

// Interview model
model Interview {
  id           String   @id @default(uuid())
  meeting_id   String   @unique
  candidate_id String
  hr_id        String
  scheduled_at DateTime
  duration     Int      @default(10) // 10 minutes session
  status       String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  scores       Json? // Scoring metrics (e.g., technical, communication, etc.)
  feedback     String?  @db.Text

  // Relations
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("interviews")
}

// File model to store binary data directly in Postgres
model File {
  id         String   @id @default(uuid())
  filename   String
  mime_type  String
  data       Bytes
  created_at DateTime @default(now())

  @@map("files")
}

// Meeting model for internal video calls
model Meeting {
  id            String   @id @default(uuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  location      String // Internal link e.g. /interview/room/[id]
  googleEventId String? // ID of the synced Google Calendar event

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetings")
}

// ─── New Models for Frontend Migration ───────────────────────────────────

model Department {
  id        String     @id @default(uuid())
  name      String     @unique // e.g., "Engineering", "Design"
  color     String     @default("bg-gray-100 text-gray-800") // Tailwind class for UI badges
  employees Employee[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("departments")
}

model Employee {
  id            String    @id @default(uuid())
  first_name    String
  last_name     String
  email         String    @unique
  phone         String?
  job_title     String
  contract_type String // "Full-time", "Part-time", "Contract"
  avatar_color  String    @default("bg-blue-500") // UI fallback
  date_of_birth DateTime? // Added for "Birthday" feature

  // Relations
  department_id String
  department    Department @relation(fields: [department_id], references: [id])

  manager_id String?
  manager    Employee?  @relation("ManagerToReport", fields: [manager_id], references: [id])
  reports    Employee[] @relation("ManagerToReport")

  leaves    LeaveRequest[]
  work_logs WorkLog[]
  performance_reviews PerformanceReview[]
  payroll             Payroll[]
  projects            EmployeeProject[]
  
  // Communication Relations
  sent_messages     Message[] @relation("Sender")
  received_messages Message[] @relation("Receiver")
  notifications     Notification[]
  read_receipts     ReadReceipt[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("employees")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  type        String   // "Company", "Department", "Role", "Individual"
  target_id   String?  // ID of Dept/Role/User if applicable
  priority    String   @default("Normal") // "Normal", "High", "Critical"
  
  author_id   String
  // author      Employee @relation(fields: [author_id], references: [id]) // Optional: if we want to link to employee

  read_receipts ReadReceipt[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("announcements")
}

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  attachment  String?  // URL to file
  tags        String[] // ["Payroll", "Legal", etc.]
  
  sender_id   String
  sender      Employee @relation("Sender", fields: [sender_id], references: [id])

  receiver_id String?  // Null if channel message
  receiver    Employee? @relation("Receiver", fields: [receiver_id], references: [id])

  channel_id  String?  // Null if direct message
  // channel     Department? @relation(fields: [channel_id], references: [id]) // Optional: link to department as channel

  read_receipts ReadReceipt[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("messages")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   // "System", "Leave", "Payroll", "Performance"
  is_read     Boolean  @default(false)
  link        String?  // Action link

  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("notifications")
}

model ReadReceipt {
  id              String   @id @default(uuid())
  read_at         DateTime @default(now())

  employee_id     String
  employee        Employee @relation(fields: [employee_id], references: [id])

  announcement_id String?
  announcement    Announcement? @relation(fields: [announcement_id], references: [id])

  message_id      String?
  message         Message? @relation(fields: [message_id], references: [id])

  @@unique([employee_id, announcement_id])
  @@unique([employee_id, message_id])
  @@map("read_receipts")
}

model PerformanceReview {
  id        String   @id @default(uuid())
  rating    Float    // 1-5
  review_date DateTime
  reviewer  String   // Name or ID of reviewer
  comments  String?
  kpis_assigned Int
  kpis_achieved Int

  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("performance_reviews")
}

model Payroll {
  id             String   @id @default(uuid())
  salary         Float    // Monthly salary
  effective_date DateTime
  pay_frequency  String   // "Monthly", "Bi-weekly"
  currency       String   @default("USD")
  
  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("payroll")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   // "Active", "Completed", "On Hold"
  start_date  DateTime
  end_date    DateTime?

  employees   EmployeeProject[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("projects")
}

model EmployeeProject {
  id          String   @id @default(uuid())
  role        String   // "Developer", "Manager", etc.
  joined_at   DateTime @default(now())

  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  project_id  String
  project     Project  @relation(fields: [project_id], references: [id])

  @@unique([employee_id, project_id])
  @@map("employee_projects")
}

model LeaveRequest {
  id         String   @id @default(uuid())
  type       String // "Annual", "Sick", "Maternity", "Unpaid"
  status     String   @default("Pending") // "Pending", "Approved", "Rejected"
  start_date DateTime
  end_date   DateTime
  reason     String?

  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("leave_requests")
}

model WorkLog {
  id           String   @id @default(uuid())
  date         DateTime
  hours_worked Float
  overtime     Float    @default(0)
  status       String // "On Time", "Late", "Absent"

  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("work_logs")
}

model CompanyPaymentMethod {
  id             String  @id @default(uuid())
  card_holder    String
  account_number String // Masked or full (security caution)
  expiration     String // MM/YY
  card_type      String // "Visa", "MasterCard"
  method_type    String // "Debit Card", "Credit Card"
  is_default     Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("company_payment_methods")
}

// Simple Task model for Dashboard
model Task {
  id           String  @id @default(uuid())
  title        String
  is_completed Boolean @default(false)

  // Optional link to user if needed later, but keeping simple for now
  // user_id     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tasks")
}
